{
  "name": "cohad",
  "private": true,
  "description": "Root package for git hooks and dev tooling",
  "scripts": {
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1"
  },
  "lint-staged": {
    "*.cs": "dotnet csharpier format",
    "Web/ClientApp/src/**/*.{ts,html,css,scss}": "prettier --write --config Web/ClientApp/.prettierrc",
    "Web/ClientApp/src/**/*.json": "prettier --write --config Web/ClientApp/.prettierrc"
  }
}
